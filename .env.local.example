NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Nur serverseitig (Website-Ticket-API) – niemals im Frontend verwenden
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Microsoft Graph (OAuth2 Client Credentials – kein Basic Auth / App-Passwort)
MICROSOFT_TENANT_ID=your-tenant-id
MICROSOFT_CLIENT_ID=your-client-id
MICROSOFT_CLIENT_SECRET=your-client-secret
MAILBOX_USER=info@flx-software.de

# Session-Signatur (Produktion: zufälligen langen Wert setzen)
AUTH_SECRET=your-random-secret

# API-Schlüssel für Website-Tickets (flx-software.de)
TICKET_API_SECRET=your-secret-key
